# LLM 配置 — 支持多个 provider, 任选一个
#
# 选 1: MiniMax (默认, 国内, 推荐)
MINIMAX_API_KEY=your-minimax-key-here
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-Text-01

# 选 2: OpenAI (海外)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  (默认, 可不设)
# LLM_MODEL=gpt-4o-mini

# 选 3: DeepSeek (国产, 便宜)
# DEEPSEEK_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# 选 4: Qwen 阿里通义 (国产)
# DASHSCOPE_API_KEY=sk-...
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 选 5: Zhipu 智谱 (国产)
# ZHIPU_API_KEY=...
# LLM_MODEL=glm-4-flash

# 选 6: Ollama 本地 (完全免费, 需装 ollama + 模型)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# (无需 API key)

# 选 7: 自定义 (OpenAI 协议)
# LLM_BASE_URL=https://your-api.com/v1
# LLM_API_KEY=your-key
# LLM_MODEL=your-model
#
# 优先级: 通用 env (LLM_*) > provider 专用 env > .env 里的 MINIMAX_*

# LLM_PROVIDER=minimax  # 不设也行, 默认 minimax (向后兼容)
